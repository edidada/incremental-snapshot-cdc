<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example.cdc</groupId>
        <artifactId>incremental-snapshot-cdc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cdc-core</artifactId>
    <packaging>jar</packaging>
    <name>cdc-core</name>
    <description>
        Database-independent algorithm core: chunk/watermark/window abstractions, the
        parallel snapshot coordinator, checkpoint/recovery, and a JDK-only in-memory
        reference implementation. No external runtime dependencies.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.example.cdc.core.demo.IncrementalSnapshotDemo</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            GraalVM Native Image profile.

            Activated with:  mvn -Pnative -pl cdc-core -am package
            Requires a GraalVM JDK (with native-image) as the build JDK, e.g.:
              export JAVA_HOME=<graalvm-jdk-21+>

            Produces target/cdc-demo — a standalone native executable of the
            self-verifying demo (IncrementalSnapshotDemo). The cdc-core engine
            is deliberately reflection-free and dependency-free, so no reachability
            metadata or native-image config files are needed (closed-world analysis
            succeeds out of the box).
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.6</version>
                        <extensions>true</extensions>
                        <configuration>
                            <mainClass>org.example.cdc.core.demo.IncrementalSnapshotDemo</mainClass>
                            <imageName>cdc-demo</imageName>
                            <buildArgs>
                                <buildArg>-O3</buildArg>
                                <buildArg>--gc=serial</buildArg>
                                <buildArg>-march=compatibility</buildArg>
                                <!-- Fail fast on any reachability gap instead of building a fallback image -->
                                <buildArg>--no-fallback</buildArg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
